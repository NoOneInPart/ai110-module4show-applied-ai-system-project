%% Music Recommender - Constrained RAG Architecture
%% Retriever = deterministic scorer (narrows catalog to candidates)
%% Generation = two LLM calls, grounded in the retrieved candidates
%% Data flow: input -> extract -> retrieve -> select -> output (single pass, no loop)
%% Human + testing checkpoints highlighted (green = human, orange = guardrail/testing)

flowchart TD
    User([" User: natural-language request<br/>e.g. 'soundtrack to watch paint dry to'"]):::human

    subgraph GEN1["LLM call 1 - Profile Extraction (src/llm.py: extract_profile)"]
        Extract["text -> UserProfile fields<br/>+ generic 'note' (vibe only,<br/>no specific-song promises)<br/>OR {error} if no signal"]
        ValidateP["Guardrail: validate_profile()<br/>clamp ranges / coerce types<br/>(shared with manual entry)"]:::guard
        Extract --> ValidateP
    end

    PrintIntro(["Printed immediately:<br/>profile intro / error"]):::human

    subgraph RETRIEVE["Retriever (deterministic, src/recommender.py)"]
        Score["score_song()<br/>score every song + reasons<br/>(ground truth, never invented)"]
        Recommend["recommend_songs()<br/>rank -> WIDE candidate set<br/>(top CANDIDATE_WIDTH ~15)"]
        Score --> Recommend
    end

    Catalog[("data/song2.csv<br/>88 real songs<br/>(CC0 Spotify dataset)")]

    subgraph GEN2["LLM call 2 - Grounded Selection (src/llm.py: select_recommendations)"]
        Select["pick & order final top-K<br/>FROM candidates + write an<br/>intro grounded in the picks"]
        Constrain["Guardrail: ids constrained to<br/>candidates; 'known' gate -<br/>personified reasons only for<br/>recognized songs, else deterministic"]:::guard
        Select --> Constrain
    end

    ManualFallback["Manual entry fallback<br/>(main.py): defaults in ( ),<br/>Enter accepts - EOF-safe,<br/>always reproducible"]:::guard

    Output([" Final picks: deterministic score<br/>+ facts, always shown; personified<br/>reasons added when known"]):::human
    HumanReview["Human review<br/>(model_card.md, this diagram):<br/>picks grounded? fallback sane?"]:::human

    subgraph TESTS["Testing System - tests/test_llm.py (offline, FakeClient)"]
        UnitTests["profile validation clamps;<br/>error/intro contract;<br/>picks subset of candidates"]:::test
        Grounding["known-gate: personified reasons<br/>only when known=true; score<br/>always the deterministic one"]:::test
        Metamorphic["recommender property checks:<br/>scoring deterministic; energy<br/>closeness is monotonic"]:::test
    end

    %% ---- data flow ----
    User --> Extract
    ValidateP -- "UserProfile" --> Score
    ValidateP -. "intro/error" .-> PrintIntro
    Score -. "reasons = ground truth" .-> Constrain
    Recommend -- "candidate set + request text" --> Select
    Recommend --> Catalog
    Constrain --> Output
    Output --> HumanReview

    GEN1 -. "no key / no signal / failure" .-> ManualFallback
    GEN2 -. "provider down / invalid output" .-> Fallback2["Fallback: deterministic top-K<br/>(same shape, no key needed)"]:::guard
    ManualFallback --> Output
    Fallback2 --> Output

    TESTS -. "exercise before release" .-> RETRIEVE
    TESTS -. "exercise before release" .-> GEN2

    classDef human fill:#d4f7d4,stroke:#2e7d32,stroke-width:2px,color:#111;
    classDef guard fill:#ffe6cc,stroke:#e65100,stroke-width:2px,color:#111;
    classDef test fill:#ffe6cc,stroke:#e65100,stroke-width:1px,color:#111,stroke-dasharray: 4 3;
